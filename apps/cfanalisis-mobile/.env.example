# URL pública de la web/API de CF Análisis (misma API que usa la web).
EXPO_PUBLIC_API_URL=https://cfanalisis.com
# WebSocket realtime del worker (mismo gateway que usa la web).
EXPO_PUBLIC_WS_URL=wss://worker.cfanalisis.com/ws
# Clave pública de Stripe (solo publishable; nunca la secreta).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
